            <TextureResolution>3072</TextureResolution>
            <ScreenAreas>
                <ScreenArea Name="ScreenArea" DisplayName="ScreenArea" TextureResolution="3072" ScreenWidth="5" ScreenHeight="3" />
                <ScreenArea Name="ScreenArea90" DisplayName="ScreenArea90" TextureResolution="1843" ScreenWidth="3" ScreenHeight="5" />
                <ScreenArea Name="ScreenArea180" DisplayName="ScreenArea180" TextureResolution="3072" ScreenWidth="5" ScreenHeight="3" />
                <ScreenArea Name="ScreenArea270" DisplayName="ScreenArea270" TextureResolution="1843" ScreenWidth="3" ScreenHeight="5" />
            </ScreenAreas>
            <MaxScreenRenderDistance>400</MaxScreenRenderDistance>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroyEffectOffset>
                <X>0</X>
                <Y>0</Y>
                <Z>-1.1</Z>
            </DestroyEffectOffset>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>45</PCU>
            <IsAirTight>false</IsAirTight>
            <DLC>SparksOfTheFuture</DLC>
        </Definition>
        
        <Definition xsi:type="MyObjectBuilder_TextPanelDefinition">
            <Id>
                <TypeId>TextPanel</TypeId>
                <SubtypeId>HighResLargeLCDPanel3x3</SubtypeId>
            </Id>
            <DisplayName>High-Res LCD 3x3 Panel</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\LCDPanel3x3.dds</Icon>
            <Description>Description_TextPanel</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\LCDPanel3x3.mwm</Model>
            <Components>
                <Component Subtype="InteriorPlate" Count="10" />
                <Component Subtype="Construction" Count="50" />
